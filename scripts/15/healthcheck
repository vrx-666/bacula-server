#!/bin/bash

# Is the process with the given id alive? kill -0 sends no signal, it only
# checks that the process exists and that we may signal it -- no grepping
# through ps output, where the number could match the RSS column or another
# process's arguments.
alive() {
	# A positive integer only. Without this guard a PID file holding zero or
	# garbage reported a false "alive": kill -0 0 signals the whole process
	# group and kill -0 -1 every process -- both always succeed.
	case "$1" in
		''|*[!0-9]*) echo 0; return ;;
	esac
	[ "$1" -gt 0 ] && kill -0 "$1" 2>/dev/null && echo 1 || echo 0
}

now=$(date +%d%H%M)
if [ "$now" == "010001" ] || [ "$now" == "010002" ]; then 
	cp -p /var/log/apache2/access.log{,.old} && :> /var/log/apache2/access.log
	cp -p /var/log/apache2/error.log{,.old} && :> /var/log/apache2/error.log
fi

health=0

#checking director
dir_pid=$(cat /opt/bacula/working/*dir*pid 2>/dev/null | head -1)
dir_check=$(alive "$dir_pid")
if [ "$dir_pid" != "" ] && [ "$dir_check" != 0 ]; then
	health=$((health+1))
fi

#checking sd
sd_pid=$(cat /opt/bacula/working/*sd*pid 2>/dev/null | head -1)
sd_check=$(alive "$sd_pid")
if [ "$sd_pid" != "" ] && [ $sd_check != 0 ]; then
	health=$((health+2))
fi

#checking fd
fd_pid=$(cat /opt/bacula/working/*fd*pid 2>/dev/null | head -1)
fd_check=$(alive "$fd_pid")
if [ "$fd_pid" != "" ] && [ $fd_check != 0 ]; then
	health=$((health+4))
fi

#checking web
web_pid=$(cat /run/apache2/apache2.pid 2>/dev/null | head -1)
web_check=$(alive "$web_pid")
if [ "$web_pid" != "" ] && [ "$web_check" != 0 ]; then
	health=$((health+8))
fi

#checking supervisor
sup_pid=$(cat /run/supervisord.pid 2>/dev/null | head -1)
sup_check=$(alive "$sup_pid")
if [ "$sup_pid" != "" ] && [ "$sup_check" != 0 ]; then
	health=$((health+16))
fi

#checking bacularis
bac=$(curl -s -I localhost:9097 | grep HTTP | cut -d " " -f 2)
if [ "$bac" = "401" ] || [ "$bac" = "301" ] || [ "$bac" = "302" ] || [ "$bac" = "200" ]; then
	health=$((health+32))
fi

if [ "$health" == 63 ]; then
	exit 0
else
	exit 1
fi
